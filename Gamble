    void setMessage(String text, Color c) {
        messageLabel.setText(text);
        messageLabel.setForeground(c);
    }

    void setBusy(boolean b) {
        busy = b;
        rollBtn.setEnabled(!b);
        flipBtn.setEnabled(!b);
        quitBtn.setEnabled(!b);
        halfBtn.setEnabled(!b);
        maxBtn.setEnabled(!b);
        betField.setEnabled(!b);
        diceNav.setEnabled(!b);
        coinNav.setEnabled(!b);
        headsBtn.setEnabled(!b);
        tailsBtn.setEnabled(!b);
    }

    Double readBet() {
        double bet;
        try {
            bet = Double.parseDouble(betField.getText().trim());
        } catch (NumberFormatException ex) {
            setMessage("Enter a valid bet amount.", RED);
            return null;
        }
        bet = Math.round(bet * 100) / 100.0;
        if (bet <= 0) {
            setMessage("Bet must be more than $0.", RED);
            return null;
        }
        if (bet > balance) {
            setMessage("Bet cannot be more than your balance.", RED);
            return null;
        }
        return bet;
    }

    void rollDice() {
        if (busy) return;
        Double betObj = readBet();
        if (betObj == null) return;
        final double bet = betObj;

        setBusy(true);
        setMessage("Rolling...", MUTED);

        final int[] fin = {random.nextInt(6) + 1, random.nextInt(6) + 1, random.nextInt(6) + 1};
        for (DiePanel d : dice) d.setValue(random.nextInt(6) + 1, false);

        final int[] tick = {0};
        final Timer t = new Timer(70, null);
        t.addActionListener(e -> {
            tick[0]++;
            for (int i = 0; i < 3; i++) {
                int lockAt = 12 + i * 8;
                if (tick[0] >= lockAt) {
                    if (!dice[i].locked) dice[i].setValue(fin[i], true);
                } else {
                    dice[i].setValue(random.nextInt(6) + 1, false);
                }
            }
            if (tick[0] >= 12 + 2 * 8) {
                t.stop();
                finishDice(fin, bet);
            }
        });
        t.start();
    }

    void finishDice(int[] f, double bet) {
        int n1 = f[0], n2 = f[1], n3 = f[2];
        int max = Math.max(n1, Math.max(n2, n3));
        int min = Math.min(n1, Math.min(n2, n3));

        double multiplier;
        String result;
        if (n1 == 6 && n2 == 6 && n3 == 6) {
            multiplier = 10;
            result = "BIG WIN!";
        } else if (n1 == n2 && n2 == n3) {
            multiplier = 5;
            result = "Triple Match!";
        } else if (n1 == n2 || n2 == n3 || n1 == n3) {
            multiplier = 0.25;
            result = "Double Match!";
        } else if (max - min == 2) {
            multiplier = 1;
            result = "Straight!";
        } else {
            applyResult(-bet, "No match. You lose " + money(bet));
            return;
        }
        double prize = Math.round(bet * multiplier * 100) / 100.0;
        applyResult(prize, result + " You win " + money(prize));
    }

    void flipCoin() {
        if (busy) return;
        Double betObj = readBet();
        if (betObj == null) return;
        final double bet = betObj;

        setBusy(true);
        setMessage("Flipping...", MUTED);

        final boolean pickHeads = headsBtn.isSelected();
        final boolean resultHeads = random.nextBoolean();
        final int halfTurns = resultHeads ? 8 : 9;
        final int frames = 70;
        final int[] f = {0};

        final Timer t = new Timer(22, null);
        t.addActionListener(e -> {
            f[0]++;
            double p = Math.min(1.0, (double) f[0] / frames);
            double ease = 1 - Math.pow(1 - p, 2.2);
            double angle = halfTurns * Math.PI * ease;
            double lift = -Math.sin(p * Math.PI) * 70;
            coin.setState(angle, lift);
            if (f[0] >= frames) {
                t.stop();
                coin.setState(halfTurns * Math.PI, 0);
                if (pickHeads == resultHeads) {
                    applyResult(bet, (resultHeads ? "Heads" : "Tails") + "! You win " + money(bet));
                } else {
                    applyResult(-bet, (resultHeads ? "Heads" : "Tails") + ". You lose " + money(bet));
                }
            }
        });
        t.start();
    }

    void applyResult(double net, String message) {
        balance = Math.round((balance + net) * 100) / 100.0;
        rounds++;
        if (net > 0) {
            wins++;
            if (net > biggestWin) biggestWin = net;
        } else if (net < 0) {
            losses++;
        }
        setMessage(message, net > 0 ? GREEN : (net < 0 ? RED : TEXT));

        final double from = displayedBalance;
        final double to = balance;
        final Color flash = net >= 0 ? GREEN : RED;
        balanceLabel.setForeground(flash);

        final int steps = 30;
        final int[] s = {0};
        final Timer t = new Timer(20, null);
        t.addActionListener(e -> {
            s[0]++;
            double p = (double) s[0] / steps;
            double ease = 1 - Math.pow(1 - p, 3);
            displayedBalance = from + (to - from) * ease;
            balanceLabel.setText(money(displayedBalance));
            if (s[0] >= steps) {
                t.stop();
                displayedBalance = to;
                balanceLabel.setText(money(to));
                balanceLabel.setForeground(GOLD);
                roundFinished();
            }
        });
        t.start();
    }

    void roundFinished() {
        if (balance <= 0) {
            JOptionPane.showMessageDialog(this,
                    "You're out of money. Game over!\n\n" + summary(),
                    "Game Over", JOptionPane.INFORMATION_MESSAGE);
            backToRegistration();
            return;
        }
        try {
            if (Double.parseDouble(betField.getText().trim()) > balance) {
                betField.setText(String.format("%.2f", balance));
            }
        } catch (NumberFormatException ignored) {
            betField.setText("10");
        }
        setBusy(false);
    }

    void quit() {
        if (busy) return;
        JOptionPane.showMessageDialog(this,
                "Thanks for playing, " + name + "!\n\n" + summary(),
                "Summary", JOptionPane.INFORMATION_MESSAGE);
        backToRegistration();
    }

    String summary() {
        double profit = balance - startBalance;
        return "Rounds played : " + rounds + "\n"
                + "Wins / Losses : " + wins + " / " + losses + "\n"
                + "Biggest win   : " + money(biggestWin) + "\n"
                + "Start balance : " + money(startBalance) + "\n"
                + "Final balance : " + money(balance) + "\n"
                + "Profit/Loss   : " + (profit >= 0 ? "+" : "-") + money(Math.abs(profit));
    }

    void backToRegistration() {
        depositField.setText("");
        regError.setText(" ");
        rootLayout.show(root, "reg");
    }

    public static void main(String[] args) {
        try {
            UIManager.setLookAndFeel(UIManager.getCrossPlatformLookAndFeelClassName());
        } catch (Exception ignored) {
        }
        SwingUtilities.invokeLater(() -> new Gamble().setVisible(true));
    }
