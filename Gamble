        diceRow.setBackground(BG);
        for (int i = 0; i < 3; i++) {
            dice[i] = new DiePanel();
            dice[i].setValue(i + 1, true);
            diceRow.add(dice[i]);
        }
        JPanel mid = new JPanel(new GridBagLayout());
        mid.setBackground(BG);
        mid.add(diceRow);
        p.add(mid, BorderLayout.CENTER);

        JPanel bottom = new JPanel();
        bottom.setLayout(new BoxLayout(bottom, BoxLayout.Y_AXIS));
        bottom.setBackground(BG);
        JLabel payout = label("<html><center>6-6-6 = x10 &nbsp;|&nbsp; Triple = x5 &nbsp;|&nbsp; Straight = x1<br>"
                + "Double = x0.25 &nbsp;|&nbsp; Otherwise = lose bet</center></html>", 12, MUTED, false);
        payout.setAlignmentX(CENTER_ALIGNMENT);
        rollBtn = button("ROLL", GOLD, new Color(40, 30, 0));
        rollBtn.setAlignmentX(CENTER_ALIGNMENT);
