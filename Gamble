    static class DiePanel extends JPanel {
        int value = 1;
        boolean locked = true;

        DiePanel() {
            setPreferredSize(new Dimension(110, 110));
            setOpaque(false);
        }

        void setValue(int v, boolean locked) {
            this.value = v;
            this.locked = locked;
            repaint();
        }

        static final double[][][] PIPS = {
            {},
            {{0.5, 0.5}},
            {{0.25, 0.25}, {0.75, 0.75}},
            {{0.25, 0.25}, {0.5, 0.5}, {0.75, 0.75}},
            {{0.25, 0.25}, {0.75, 0.25}, {0.25, 0.75}, {0.75, 0.75}},
            {{0.25, 0.25}, {0.75, 0.25}, {0.5, 0.5}, {0.25, 0.75}, {0.75, 0.75}},
            {{0.25, 0.25}, {0.75, 0.25}, {0.25, 0.5}, {0.75, 0.5}, {0.25, 0.75}, {0.75, 0.75}}
        };

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            int s = Math.min(getWidth(), getHeight()) - 12;
            int x = (getWidth() - s) / 2;
            int y = (getHeight() - s) / 2;

            g2.setColor(new Color(0, 0, 0, 80));
            g2.fillRoundRect(x + 4, y + 6, s, s, 26, 26);
            g2.setColor(locked ? Color.WHITE : new Color(215, 218, 232));
            g2.fillRoundRect(x, y, s, s, 26, 26);
            g2.setStroke(new BasicStroke(3f));
            g2.setColor(locked ? GOLD : new Color(140, 145, 165));
            g2.drawRoundRect(x, y, s, s, 26, 26);
            g2.setColor(new Color(25, 28, 45));
            int r = Math.max(5, s / 11);
            for (double[] p : PIPS[value]) {
                int cx = x + (int) (p[0] * s);
                int cy = y + (int) (p[1] * s);
                g2.fillOval(cx - r, cy - r, r * 2, r * 2);
            }
            g2.dispose();
        }
    }

    static class CoinPanel extends JPanel {
        double scaleX = 1;
        double yOffset = 0;
        boolean heads = true;

        CoinPanel() {
            setPreferredSize(new Dimension(220, 250));
            setOpaque(false);
        }

        void setState(double angle, double yOffset) {
            double c = Math.cos(angle);
            this.scaleX = Math.max(0.04, Math.abs(c));
            this.heads = c >= 0;
            this.yOffset = yOffset;
            repaint();
        }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);

            int cx = getWidth() / 2;
            int groundY = getHeight() - 30;
            int cy = groundY - 70 + (int) yOffset;
            int r = 55;

            double lift = Math.min(1, Math.abs(yOffset) / 70.0);
            int sw = (int) (r * 1.6 * (1 - 0.45 * lift));
            g2.setColor(new Color(0, 0, 0, (int) (90 - 50 * lift)));
            g2.fillOval(cx - sw, groundY - 6, sw * 2, 14);

            AffineTransform old = g2.getTransform();
            g2.translate(cx, cy);
            g2.scale(scaleX, 1);

            g2.setPaint(new GradientPaint(-r, -r, new Color(255, 225, 90), r, r, new Color(214, 150, 0)));
            g2.fillOval(-r, -r, r * 2, r * 2);
            g2.setStroke(new BasicStroke(5f));
            g2.setColor(new Color(150, 100, 0));
            g2.drawOval(-r, -r, r * 2, r * 2);
            g2.setStroke(new BasicStroke(2f));
            g2.setColor(new Color(255, 240, 160));
            g2.drawOval(-r + 9, -r + 9, (r - 9) * 2, (r - 9) * 2);

            g2.setFont(new Font("SansSerif", Font.BOLD, 54));
            FontMetrics fm = g2.getFontMetrics();
            String s = heads ? "H" : "T";
            g2.setColor(new Color(130, 85, 0));
            g2.drawString(s, -fm.stringWidth(s) / 2, fm.getAscent() / 2 - 4);

            g2.setTransform(old);
            g2.dispose();
        }
    }

    static JLabel label(String text, int size, Color color, boolean bold) {
        JLabel l = new JLabel(text);
        l.setFont(new Font("SansSerif", bold ? Font.BOLD : Font.PLAIN, size));
        l.setForeground(color);
        return l;
    }

    static JButton button(String text, Color bg, Color fg) {
        JButton b = new JButton(text);
        b.setFont(new Font("SansSerif", Font.BOLD, 15));
        b.setBackground(bg);
        b.setForeground(fg);
        b.setOpaque(true);
        b.setFocusPainted(false);
        b.setBorder(BorderFactory.createEmptyBorder(10, 22, 10, 22));
        b.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        return b;
    }

    static JTextField field(int cols) {
        JTextField f = new JTextField(cols);
        f.setFont(new Font("SansSerif", Font.PLAIN, 16));
        f.setBackground(CARD);
        f.setForeground(TEXT);
        f.setCaretColor(GOLD);
        f.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(60, 70, 100)),
                BorderFactory.createEmptyBorder(6, 8, 6, 8)));
        return f;
    }

    static String money(double v) {
        return String.format("$%.2f", v);
    }

    public Gamble() {
        super("$$$ Gamble $$$");
        root.setBackground(BG);
        root.add(buildRegistration(), "reg");
        root.add(buildGame(), "game");
        setContentPane(root);
        setSize(560, 720);
        setMinimumSize(new Dimension(520, 700));
        setLocationRelativeTo(null);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
    }

    JPanel buildRegistration() {
        JPanel p = new JPanel(new GridBagLayout());
        p.setBackground(BG);

        JPanel box = new JPanel();
        box.setLayout(new BoxLayout(box, BoxLayout.Y_AXIS));
        box.setBackground(CARD);
        box.setBorder(BorderFactory.createEmptyBorder(30, 40, 30, 40));

        JLabel title = label("$$$ GAMBLE $$$", 30, GOLD, true);
        title.setAlignmentX(CENTER_ALIGNMENT);
        JLabel sub = label("Registration (18+ only)", 14, MUTED, false);
        sub.setAlignmentX(CENTER_ALIGNMENT);

        nameField = field(18);
        ageField = field(18);
        depositField = field(18);
        regError = label(" ", 13, RED, false);
        regError.setAlignmentX(CENTER_ALIGNMENT);

        JButton start = button("START", GOLD, new Color(40, 30, 0));
        start.setAlignmentX(CENTER_ALIGNMENT);
        start.addActionListener(e -> startGame());
        ActionListener enter = e -> startGame();
        nameField.addActionListener(enter);
        ageField.addActionListener(enter);
        depositField.addActionListener(enter);

        box.add(title);
        box.add(Box.createVerticalStrut(4));
        box.add(sub);
        box.add(Box.createVerticalStrut(22));
        addRow(box, "Name", nameField);
        addRow(box, "Age", ageField);
        addRow(box, "Deposit ($)", depositField);
        box.add(Box.createVerticalStrut(6));
        box.add(regError);
        box.add(Box.createVerticalStrut(14));
        box.add(start);

        p.add(box);
        return p;
    }

    void addRow(JPanel parent, String text, JTextField f) {
        JLabel l = label(text, 13, MUTED, false);
        l.setAlignmentX(CENTER_ALIGNMENT);
        f.setAlignmentX(CENTER_ALIGNMENT);
        f.setHorizontalAlignment(JTextField.CENTER);
        f.setMaximumSize(new Dimension(260, 38));
        parent.add(l);
        parent.add(Box.createVerticalStrut(4));
        parent.add(f);
        parent.add(Box.createVerticalStrut(12));
    }

    void startGame() {
        String n = nameField.getText().trim();
        if (n.isEmpty()) n = "Player";

        int age;
        try {
            age = Integer.parseInt(ageField.getText().trim());
        } catch (NumberFormatException ex) {
            regError.setText("Please enter a valid age.");
            return;
        }
        if (age < 18) {
            regError.setText("You are not eligible. Registration rejected.");
            return;
        }

        double dep;
        try {
            dep = Double.parseDouble(depositField.getText().trim());
        } catch (NumberFormatException ex) {
            regError.setText("Please enter a valid deposit amount.");
            return;
        }
        if (dep < 1 || dep > 10000) {
            regError.setText("Deposit must be between $1 and $10,000.");
            return;
        }

        name = n;
        balance = Math.round(dep * 100) / 100.0;
        startBalance = balance;
        displayedBalance = balance;
        rounds = wins = losses = 0;
        biggestWin = 0;
        regError.setText(" ");

        balanceLabel.setText(money(balance));
        balanceLabel.setForeground(GOLD);
        setMessage("Welcome " + name + "! Place your bet.", TEXT);
        betField.setText("10");
        setBusy(false);
        rootLayout.show(root, "game");
    }

